# Local development only. Copy to .env (gitignored). Never commit real secrets.
# An unset APP_ENV means production (fail closed).
APP_ENV=development
ADDR=:8080
BASE_URL=http://localhost:8080
DEBUG=false

# Cookies always use the __Host- prefix and Secure; browsers accept Secure cookies on localhost.
COOKIE_SECURE=true
# base64 of 32 random bytes: openssl rand -base64 32 (required in production)
COOKIE_ENC_KEY=

HSTS_MAX_AGE=63072000

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted.
# The proxy must overwrite X-Forwarded-Proto and strip X-Forwarded-Ssl/-Protocol/-Host and X-Url-Scheme.
TRUSTED_PROXIES=

# Set both to terminate TLS in-process.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Production requires sslmode=verify-full or verify-ca.
DATABASE_URL=postgres://app@localhost:5432/app?sslmode=disable
DB_ALLOW_INSECURE_LOCAL=false
